  description          String
  quantity             Int
  unitPriceAmount      Int
  grossUnitPriceAmount Int?
  factusPrice          String?
  discountAmount       Int     @default(0)
  factusDiscountAmount String?
  taxableAmount        Int     @default(0)
  subtotalAmount       Int
  taxAmount            Int     @default(0)
  totalAmount          Int
