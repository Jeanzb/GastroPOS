enum CashSessionStatus {
  OPEN
  CLOSED
}

enum CashMovementType {
  OPENING_BALANCE
  CASH_IN
  CASH_OUT
  SALE_PAYMENT
  REFUND
  TIP
  ADJUSTMENT
}

/// A cash register session for a branch: opened with a balance, closed with a count.
/// Money is stored in integer minor units; never float.
model CashSession {
  id       String            @id @default(cuid())
  tenantId String
  branchId String
  status   CashSessionStatus @default(OPEN)
  currency String            @default("COP")

  openingBalance Int     @default(0)
  expectedAmount Int?
  countedAmount  Int?
  difference     Int?
  notes          String?

  openedById String
  closedById String?
  openedAt   DateTime  @default(now())
  closedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant    Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch    Branch         @relation(fields: [branchId], references: [id], onDelete: Cascade)
  movements CashMovement[]
  sales     Sale[]

  @@index([tenantId])
  @@index([tenantId, branchId, status])
  @@map("cash_sessions")
}

/// An individual cash movement within a session.
model CashMovement {
  id            String           @id @default(cuid())
  tenantId      String
  branchId      String
  cashSessionId String
  type          CashMovementType
  amount        Int
  reference     String?
  notes         String?

  createdById String
  createdAt   DateTime @default(now())

  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  cashSession CashSession @relation(fields: [cashSessionId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([cashSessionId])
  @@map("cash_movements")
}

enum SaleStatus {
  DRAFT
  CLOSED
  CANCELLED
}

enum PaymentMethod {
  CASH
  CARD
  TRANSFER
  OTHER
}

/// A point-of-sale ticket. Closed sales are immutable except via cancellation.
/// All money is stored in integer minor units; never float.
model Sale {
  id               String               @id @default(cuid())
  tenantId         String
  branchId         String
  cashSessionId    String?
  diningTableId    String?
  customerId       String?
  fiscalDocumentId String?              @unique
  status           SaleStatus           @default(DRAFT)
  fiscalStatus     FiscalInvoiceStatus?
  currency         String               @default("COP")

  guestCount Int?
  waiterName String?

  customerName    String?
  requiresInvoice Boolean @default(false)

  subtotal       Int @default(0)
  discountTotal  Int @default(0)
  taxTotal       Int @default(0)
  tipAmount      Int @default(0)
  roundingAmount Int @default(0)
  grandTotal     Int @default(0)
  paidTotal      Int @default(0)

  notes        String?
  cancelReason String?

  createdById String
  closedById  String?
  closedAt    DateTime?
  cancelledAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant         Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch         Branch       @relation(fields: [branchId], references: [id], onDelete: Cascade)
  cashSession    CashSession? @relation(fields: [cashSessionId], references: [id], onDelete: SetNull)
  diningTable    DiningTable? @relation(fields: [diningTableId], references: [id], onDelete: SetNull)
  customer       Customer?    @relation(fields: [customerId], references: [id], onDelete: SetNull)
  fiscalDocument Invoice?     @relation("SalePrimaryFiscalDocument", fields: [fiscalDocumentId], references: [id], onDelete: SetNull)
  invoices       Invoice[]    @relation("SaleInvoices")
  items          SaleItem[]
  payments       Payment[]

  @@index([tenantId])
  @@index([tenantId, branchId, status])
  @@index([tenantId, fiscalStatus])
  @@index([tenantId, diningTableId, status])
  @@index([cashSessionId])
  @@map("sales")
}

/// A line in a sale. Product name and unit price are snapshotted at sale time.
model SaleItem {
  id        String  @id @default(cuid())
  tenantId  String
  saleId    String
  productId String?

  nameSnapshot        String
  unitPriceSnapshot   Int
  quantity            Int     @default(1)
  lineTotal           Int
  fiscalName          String?
  fiscalCodeReference String?
  unitMeasureCode     String  @default("94")
  standardCode        String  @default("999")
  factusTaxCode       String  @default("01")
  taxRateBasisPoints  Int     @default(0)
  isTaxExcluded       Boolean @default(false)

  createdAt DateTime @default(now())

  tenant  Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sale    Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([saleId])
  @@map("sale_items")
}

/// A payment registered against a sale.
model Payment {
  id                      String        @id @default(cuid())
  tenantId                String
  saleId                  String
  method                  PaymentMethod
  amount                  Int
  reference               String?
  factusPaymentMethodCode String?
  paymentForm             Int           @default(1)
  dueDate                 DateTime?
  acquirerReference       String?
  reconciledAt            DateTime?

  createdById String
  createdAt   DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sale   Sale   @relation(fields: [saleId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([saleId])
  @@map("payments")
}

/// Colombian identification document types for customers (DIAN).
enum CustomerDocumentType {
  CC
  NIT
  CE
  PP
  TI
  NUIP
  OTHER
}

/// A customer registry with fiscal data for electronic invoicing (DIAN).
model Customer {
  id                       String               @id @default(cuid())
  tenantId                 String
  documentType             CustomerDocumentType @default(CC)
  documentNumber           String
  dv                       String?
  factusIdentificationCode String?
  legalOrganizationCode    String?
  company                  String?
  names                    String?
  name                     String
  email                    String?
  phone                    String?
  address                  String?
  countryCode              String               @default("CO")
  municipality             String?
  municipalityCode         String?
  tributeCode              String?
  taxResponsibility        String?
  taxResponsibilities      String[]             @default([])
  isActive                 Boolean              @default(true)

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  createdById String?
  updatedById String?

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invoices Invoice[]
  sales    Sale[]

  @@unique([tenantId, documentType, documentNumber])
  @@index([tenantId])
  @@index([tenantId, isActive])
  @@map("customers")
}

enum PurchaseStatus {
  DRAFT
  RECEIVED
  CANCELLED
}

enum StockMovementType {
  PURCHASE
  SALE_CONSUMPTION
  ADJUSTMENT_IN
  ADJUSTMENT_OUT
  WASTE
  TRANSFER_IN
  TRANSFER_OUT
  RETURN
}

/// A supplier/vendor the tenant buys from.
model Supplier {
  id             String  @id @default(cuid())
  tenantId       String
  name           String
  documentNumber String?
  email          String?
  phone          String?
  address        String?
  isActive       Boolean @default(true)

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  createdById String?
  updatedById String?

  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  purchases Purchase[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@index([tenantId, isActive])
  @@map("suppliers")
}

/// A purchase from a supplier. Receiving will feed inventory once it exists.
/// Money is stored in integer minor units; never float.
model Purchase {
  id         String         @id @default(cuid())
  tenantId   String
  branchId   String?
  supplierId String
  status     PurchaseStatus @default(DRAFT)
  currency   String         @default("COP")

  reference String?
  notes     String?

  subtotal Int @default(0)
  taxTotal Int @default(0)
  total    Int @default(0)

  receivedAt  DateTime?
  createdById String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  tenant         Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch         Branch?         @relation(fields: [branchId], references: [id], onDelete: SetNull)
  supplier       Supplier        @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  items          PurchaseItem[]
  stockMovements StockMovement[]

  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, createdAt])
  @@index([supplierId])
  @@map("purchases")
}

/// A line in a purchase. Product name and unit cost are snapshotted.
model PurchaseItem {
  id         String  @id @default(cuid())
  tenantId   String
  purchaseId String
  productId  String?

  nameSnapshot String
  quantity     Int
  unitCost     Int
  lineTotal    Int

  createdAt DateTime @default(now())

  tenant         Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  purchase       Purchase        @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  product        Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)
  stockMovements StockMovement[]

  @@index([tenantId])
  @@index([purchaseId])
  @@map("purchase_items")
}

/// Unit catalog used by inventory items. Conversions are explicit future work.
enum UnitDimension {
  MASS
  VOLUME
  COUNT
}

model UnitOfMeasure {
  id       String @id @default(cuid())
  tenantId String
  code     String
  name     String

  // Physical dimension + multiplier to the canonical base of that dimension
  // (MASS->g, VOLUME->ml, COUNT->und). Enables recipe/purchase unit conversion.
  dimension UnitDimension @default(COUNT)
  factor    Float         @default(1)

  isActive Boolean @default(true)

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  createdById String?
  updatedById String?

  tenant               Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  inventoryIngredients InventoryIngredient[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([tenantId, isActive])
  @@map("unit_of_measures")
}

model InventoryCategory {
  id        String @id @default(cuid())
  tenantId  String
  code      String
  name      String
  skuPrefix String

  isActive Boolean @default(true)

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  createdById String?
  updatedById String?

  tenant      Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  ingredients InventoryIngredient[]

  @@unique([tenantId, code])
  @@unique([tenantId, skuPrefix])
  @@index([tenantId])
  @@index([tenantId, isActive])
  @@index([tenantId, deletedAt])
  @@map("inventory_categories")
}

model InventorySkuSequence {
  id         String @id @default(cuid())
  tenantId   String
  prefix     String
  nextNumber Int    @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, prefix])
  @@index([tenantId])
  @@map("inventory_sku_sequences")
}

/// Tenant-level ingredient catalog entry. Branch-specific stock lives in InventoryBalance.
model InventoryIngredient {
  id         String  @id @default(cuid())
  tenantId   String
  productId  String?
  baseUnitId String
  categoryId String

  name     String
  sku      String
  isActive Boolean @default(true)

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  createdById String?
  updatedById String?

  tenant            Tenant                    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  product           Product?                  @relation(fields: [productId], references: [id], onDelete: SetNull)
  baseUnit          UnitOfMeasure             @relation(fields: [baseUnitId], references: [id], onDelete: Restrict)
  category          InventoryCategory         @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  balances          InventoryBalance[]
  movements         StockMovement[]
  recipeIngredients ProductRecipeIngredient[]

  @@unique([tenantId, sku])
  @@unique([tenantId, productId])
  @@index([tenantId])
  @@index([tenantId, productId])
  @@index([tenantId, categoryId])
  @@index([tenantId, isActive])
  @@map("inventory_ingredients")
}

/// Current inventory balance for an ingredient in a branch. Mutations must create movements.
model InventoryBalance {
  id           String @id @default(cuid())
  tenantId     String
  branchId     String
  ingredientId String

  stockOnHand        Int     @default(0)
  minimumStock       Int     @default(0)
  averageCost        Int     @default(0)
  allowNegativeStock Boolean @default(false)

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  createdById String?
  updatedById String?

  tenant     Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch     Branch              @relation(fields: [branchId], references: [id], onDelete: Cascade)
  ingredient InventoryIngredient @relation(fields: [ingredientId], references: [id], onDelete: Restrict)
  movements  StockMovement[]

  @@unique([tenantId, branchId, ingredientId])
  @@index([tenantId])
  @@index([tenantId, branchId])
  @@index([ingredientId])
  @@map("inventory_balances")
}

/// Kardex-style inventory movement. Every stock-changing workflow writes one.
model StockMovement {
  id                 String            @id @default(cuid())
  tenantId           String
  branchId           String
  inventoryBalanceId String
  ingredientId       String
  purchaseId         String?
  purchaseItemId     String?
  type               StockMovementType

  quantity    Int
  unitCost    Int?
  totalCost   Int?
  stockBefore Int
  stockAfter  Int
  reason      String?

  createdById String
  createdAt   DateTime @default(now())

  tenant           Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch           Branch              @relation(fields: [branchId], references: [id], onDelete: Cascade)
  inventoryBalance InventoryBalance    @relation(fields: [inventoryBalanceId], references: [id], onDelete: Restrict)
  ingredient       InventoryIngredient @relation(fields: [ingredientId], references: [id], onDelete: Restrict)
  purchase         Purchase?           @relation(fields: [purchaseId], references: [id], onDelete: SetNull)
  purchaseItem     PurchaseItem?       @relation(fields: [purchaseItemId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([tenantId, branchId])
  @@index([inventoryBalanceId])
  @@index([ingredientId])
  @@index([purchaseId])
  @@index([tenantId, type, createdAt])
  @@map("stock_movements")
}
