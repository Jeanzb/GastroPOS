// GastroAI data model.
// Multi-tenant rule (AGENTS.md §6.2, §7): every business record carries a
// tenantId and audit fields. Tenant isolation is enforced in repositories.

generator client {
  provider = "prisma-client-js"
  output   = "../apps/api/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Default RBAC roles (AGENTS.md §6.3). Granular permissions come later.
enum UserRole {
  OWNER
  ADMIN
  CASHIER
  WAITER
  KITCHEN
  INVENTORY_MANAGER
  ACCOUNTANT
}

enum AuthScope {
  TENANT
  POS
  PLATFORM
}

enum PlatformRole {
  PLATFORM_OWNER
  PLATFORM_ADMIN
  SUPPORT_AGENT
}

enum TenantStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  SUSPENDED
  CANCELLED
  ARCHIVED
}

enum FiscalProviderType {
  DIAN_DIRECT
  TECHNOLOGY_PROVIDER
  API_PROVIDER
}

/// The Factus environment is part of the tenant fiscal boundary. A sandbox
/// token must never be reused for the production issuer of another tenant.
enum FactusEnvironment {
  SANDBOX
  PRODUCTION
}

enum FactusConnectionStatus {
  NOT_CONFIGURED
  PENDING_VERIFICATION
  READY
  DEGRADED
  ERROR
}

enum FiscalOutboxStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  DEAD_LETTER
}

enum FiscalInvoiceStatus {
  DRAFT
  READY_TO_SEND
  PENDING_VALIDATION
  SENT_TO_PROVIDER
  SENT
  ACCEPTED_BY_DIAN
  ACCEPTED
  REJECTED_BY_DIAN
  REJECTED
  CANCELLED_BEFORE_ISSUE
  CANCELLED
  CORRECTED_WITH_CREDIT_NOTE
  PARTIALLY_REFUNDED
  FULLY_REFUNDED
  FAILED
}

enum FiscalInvoiceEventType {
  CREATED
  READY_TO_SEND
  PENDING_VALIDATION
  SENT_TO_PROVIDER
  SUBMITTED
  ACCEPTED_BY_DIAN
  ACCEPTED
  REJECTED_BY_DIAN
  REJECTED
  FAILED
  RETRY_REQUESTED
  ARTIFACTS_DOWNLOADED
  CANCELLED
  PROVIDER_SYNCED
}

enum CreditNoteEventType {
  CREATED
  PENDING_VALIDATION
  SENT_TO_PROVIDER
  ACCEPTED_BY_DIAN
  REJECTED_BY_DIAN
  FAILED
  RETRY_REQUESTED
  ARTIFACTS_DOWNLOADED
}

/// Provider-agnostic operational telemetry retained by the SaaS platform.
/// It intentionally contains no tenant, customer, sale, document, payload, or secret data.
enum IntegrationProvider {
  FACTUS
}

enum IntegrationOperation {
  HEALTH_CHECK
  AUTHENTICATION
  API_REQUEST
}

enum IntegrationLogStatus {
  SUCCESS
  WARNING
  ERROR
}

/// A restaurant business. Root of tenant isolation.
model Tenant {
  id       String       @id @default(cuid())
  name     String
  slug     String       @unique
  isActive Boolean      @default(true)
  status   TenantStatus @default(ACTIVE)

  planId           String?
  trialEndsAt      DateTime?
  suspendedAt      DateTime?
  cancelledAt      DateTime?
  archivedAt       DateTime?
  suspensionReason String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  plan                       Plan?                       @relation(fields: [planId], references: [id], onDelete: SetNull)
  settings                   TenantSettings?
  branches                   Branch[]
  users                      User[]
  sessions                   Session[]
  featureOverrides           TenantFeatureOverride[]
  productCategories          ProductCategory[]
  products                   Product[]
  taxCategories              TaxCategory[]
  productRecipes             ProductRecipe[]
  productRecipeIngredients   ProductRecipeIngredient[]
  fiscalProfile              FiscalProfile?
  factusConnection           FactusConnection?
  fiscalOutboxEvents         FiscalOutboxEvent[]
  invoices                   Invoice[]
  dianResponses              DianResponse[]
  creditNotes                CreditNote[]
  creditNoteLines            CreditNoteLine[]
  creditNoteResponses        CreditNoteResponse[]
  creditNoteEvents           CreditNoteEvent[]
  debitNotes                 DebitNote[]
  accountingEntries          AccountingEntry[]
  cashSessions               CashSession[]
  cashMovements              CashMovement[]
  sales                      Sale[]
  saleItems                  SaleItem[]
  payments                   Payment[]
  customers                  Customer[]
  suppliers                  Supplier[]
  purchases                  Purchase[]
  purchaseItems              PurchaseItem[]
  unitsOfMeasure             UnitOfMeasure[]
  inventoryCategories        InventoryCategory[]
  inventoryIngredients       InventoryIngredient[]
  inventorySkuSequences      InventorySkuSequence[]
  inventoryBalances          InventoryBalance[]
  stockMovements             StockMovement[]
  diningZones                DiningZone[]
  diningTables               DiningTable[]
  branchFiscalConfigurations BranchFiscalConfiguration[]

  @@index([planId])
  @@index([status])
  @@index([deletedAt])
  @@index([status, deletedAt])
  @@map("tenants")
}

model PlatformUser {
  id           String       @id @default(cuid())
  email        String       @unique
  passwordHash String
  fullName     String
  role         PlatformRole @default(PLATFORM_ADMIN)
  isActive     Boolean      @default(true)
  lastLoginAt  DateTime?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  createdById String?
  updatedById String?

  sessions PlatformSession[]

  @@index([isActive])
  @@map("platform_users")
}

model PlatformSession {
  id             String @id @default(cuid())
  platformUserId String

  isActive  Boolean   @default(true)
  expiresAt DateTime
  revokedAt DateTime?

  ipAddress String?
  userAgent String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user          PlatformUser           @relation(fields: [platformUserId], references: [id], onDelete: Cascade)
  refreshTokens PlatformRefreshToken[]

  @@index([platformUserId])
  @@index([platformUserId, isActive])
  @@index([expiresAt])
  @@map("platform_sessions")
}

model PlatformRefreshToken {
  id                String @id @default(cuid())
  platformSessionId String
  tokenHash         String
  familyId          String

  expiresAt         DateTime
  revokedAt         DateTime?
  replacedByTokenId String?

  createdAt DateTime @default(now())

  session PlatformSession @relation(fields: [platformSessionId], references: [id], onDelete: Cascade)

  @@index([platformSessionId])
  @@index([familyId])
  @@index([expiresAt])
  @@map("platform_refresh_tokens")
}

model Plan {
  id          String  @id @default(cuid())
  code        String  @unique
  name        String
  description String?
  isActive    Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenants  Tenant[]
  features PlanFeature[]

  @@index([isActive])
  @@map("plans")
}

model Feature {
  id          String  @id @default(cuid())
  code        String  @unique
  name        String
  description String?
  isActive    Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  plans           PlanFeature[]
  tenantOverrides TenantFeatureOverride[]

  @@index([isActive])
  @@map("features")
}

model PlanFeature {
  id        String  @id @default(cuid())
  planId    String
  featureId String
  enabled   Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  plan    Plan    @relation(fields: [planId], references: [id], onDelete: Cascade)
  feature Feature @relation(fields: [featureId], references: [id], onDelete: Cascade)

  @@unique([planId, featureId])
  @@index([planId])
  @@index([featureId])
  @@map("plan_features")
}

model TenantFeatureOverride {
  id        String  @id @default(cuid())
  tenantId  String
  featureId String
  enabled   Boolean
  reason    String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String?
  updatedById String?

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  feature Feature @relation(fields: [featureId], references: [id], onDelete: Cascade)

  @@unique([tenantId, featureId])
  @@index([tenantId])
  @@index([featureId])
  @@map("tenant_feature_overrides")
}

/// Per-tenant configuration that business logic must not hardcode.
model TenantSettings {
  id                      String  @id @default(cuid())
  tenantId                String  @unique
  currency                String  @default("COP")
  timezone                String  @default("America/Bogota")
  allowNegativeStock      Boolean @default(false)
  // Local hour (0-23) when the business day rolls over; operational POS sessions are force-closed at this hour.
  businessDayStartsAtHour Int     @default(4)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("tenant_settings")
}

/// A physical location / sede of a tenant.
model Branch {
  id       String  @id @default(cuid())
  tenantId String
  name     String
  code     String
  city     String?
  address  String?
  phone    String?
  isActive Boolean @default(true)

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  createdById String?
  updatedById String?

  tenant             Tenant                     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  users              User[]
  sessions           Session[]
  invoices           Invoice[]
  creditNotes        CreditNote[]
  debitNotes         DebitNote[]
  accountingEntries  AccountingEntry[]
  cashSessions       CashSession[]
  sales              Sale[]
  purchases          Purchase[]
  inventoryBalances  InventoryBalance[]
  stockMovements     StockMovement[]
  diningZones        DiningZone[]
  diningTables       DiningTable[]
  fiscalSettings     BranchFiscalConfiguration?
  fiscalOutboxEvents FiscalOutboxEvent[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([tenantId, deletedAt])
  @@index([tenantId, isActive])
  @@map("branches")
}

enum DiningTableStatus {
  FREE
  OCCUPIED
  PENDING_BILL
  RESERVED
}

/// Physical zone inside a restaurant branch, such as main dining room or terrace.
model DiningZone {
  id       String @id @default(cuid())
  tenantId String
  branchId String

  name      String
  sortOrder Int     @default(0)
  isActive  Boolean @default(true)

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  createdById String?
  updatedById String?

  tenant Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch Branch        @relation(fields: [branchId], references: [id], onDelete: Cascade)
  tables DiningTable[]

  @@index([tenantId])
  @@index([tenantId, branchId])
  @@index([tenantId, branchId, name])
  @@map("dining_zones")
}

/// A billable physical table. POS/order linkage will attach to this table later.
model DiningTable {
  id       String @id @default(cuid())
  tenantId String
  branchId String
  zoneId   String

  number String
  seats  Int               @default(4)
  status DiningTableStatus @default(FREE)

  waiterName      String?
  openedAt        DateTime?
  reservationName String?
  reservationTime String?
  notes           String?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  createdById String?
  updatedById String?

  tenant Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch Branch     @relation(fields: [branchId], references: [id], onDelete: Cascade)
  zone   DiningZone @relation(fields: [zoneId], references: [id], onDelete: Restrict)
  sales  Sale[]

  @@index([tenantId])
  @@index([tenantId, branchId])
  @@index([tenantId, branchId, number])
  @@index([zoneId])
  @@index([tenantId, branchId, status])
  @@map("dining_tables")
}

/// A staff account scoped to a single tenant.
model User {
  id             String    @id @default(cuid())
  tenantId       String
  branchId       String?
  email          String
  passwordHash   String
  fullName       String
  // National ID (cédula). Unique per tenant; used as the staff POS login identifier.
  documentNumber String?
  role           UserRole  @default(CASHIER)
  isActive       Boolean   @default(true)
  lastLoginAt    DateTime?

  // Fast POS terminal login. PIN is hashed; uniqueness per branch is enforced in app logic.
  pinHash           String?
  pinUpdatedAt      DateTime?
  failedPinAttempts Int       @default(0)
  pinLockedUntil    DateTime?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  createdById String?
  updatedById String?

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch   Branch?   @relation(fields: [branchId], references: [id], onDelete: SetNull)
  sessions Session[]

  @@unique([tenantId, email])
  @@unique([tenantId, documentNumber])
  @@index([tenantId])
  @@index([branchId])
  @@index([branchId, isActive])
  @@index([branchId, documentNumber])
  @@map("users")
}

/// Authenticated device/browser session for a staff user.
model Session {
  id        String    @id @default(cuid())
  tenantId  String
  branchId  String?
  userId    String
  authScope AuthScope @default(TENANT)

  isActive  Boolean   @default(true)
  expiresAt DateTime
  revokedAt DateTime?

  ipAddress String?
  userAgent String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch        Branch?        @relation(fields: [branchId], references: [id], onDelete: SetNull)
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokens RefreshToken[]

  @@index([tenantId])
  @@index([tenantId, branchId])
  @@index([userId])
  @@index([branchId])
  @@index([isActive, expiresAt])
  @@index([expiresAt])
  @@map("sessions")
}

/// Refresh token secret hash. The public token id is the record id.
model RefreshToken {
  id        String @id @default(cuid())
  sessionId String
  tokenHash String
  familyId  String

  expiresAt         DateTime
  revokedAt         DateTime?
  replacedByTokenId String?

  createdAt DateTime @default(now())

  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([familyId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

/// Immutable trail of business-critical actions.
model AuditLog {
  id          String  @id @default(cuid())
  tenantId    String?
  branchId    String?
  actorUserId String?
  action      String
  entityType  String
  entityId    String?

  before   Json?
  after    Json?
  metadata Json?

  ipAddress String?
  userAgent String?
  requestId String?

  createdAt DateTime @default(now())

  @@index([tenantId, createdAt])
  @@index([tenantId, entityType, entityId])
  @@index([actorUserId])
  @@map("audit_logs")
}

/// Sanitized global technical log for external integrations. SuperAdmin can
/// inspect platform reliability without operating a restaurant's fiscal data.
model PlatformIntegrationLog {
  id        String               @id @default(cuid())
  provider  IntegrationProvider
  operation IntegrationOperation
  status    IntegrationLogStatus

  httpStatus Int?
  errorCode  String?
  message    String?
  latencyMs  Int?
  createdAt  DateTime @default(now())

  @@index([provider, createdAt])
  @@index([status, createdAt])
  @@map("platform_integration_logs")
}

/// Grouping of catalog products (menu sections).
model ProductCategory {
  id        String  @id @default(cuid())
  tenantId  String
  name      String
  sortOrder Int     @default(0)
  isActive  Boolean @default(true)

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  createdById String?
  updatedById String?

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  products Product[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@index([tenantId, isActive])
  @@map("product_categories")
}

/// A sellable and/or inventoried catalog item.
/// Money is stored in integer minor units (COP has no decimals); never float.
model Product {
  id            String  @id @default(cuid())
  tenantId      String
  categoryId    String?
  taxCategoryId String?
  sku           String?
  name          String
  description   String?

  priceAmount Int    @default(0)
  currency    String @default("COP")

  fiscalName          String?
  fiscalCodeReference String?
  unitMeasureCode     String  @default("94")
  standardCode        String  @default("999")
  isExcluded          Boolean @default(false)
  incApplies          Boolean @default(false)

  isActive      Boolean @default(true)
  isSellable    Boolean @default(true)
  isInventoried Boolean @default(false)

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  createdById String?
  updatedById String?

  tenant               Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  category             ProductCategory?      @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  taxCategory          TaxCategory?          @relation(fields: [taxCategoryId], references: [id], onDelete: SetNull)
  saleItems            SaleItem[]
  purchaseItems        PurchaseItem[]
  inventoryIngredients InventoryIngredient[]
  recipes              ProductRecipe[]

  @@unique([tenantId, sku])
  @@index([tenantId])
  @@index([tenantId, categoryId])
  @@index([tenantId, taxCategoryId])
  @@index([tenantId, isActive])
  @@map("products")
}

model TaxCategory {
  id       String @id @default(cuid())
  tenantId String

  code            String
  name            String
  factusTaxCode   String
  rateBasisPoints Int       @default(0)
  isVat           Boolean   @default(false)
  isInc           Boolean   @default(false)
  isExcluded      Boolean   @default(false)
  validFrom       DateTime?
  validUntil      DateTime?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  createdById String?
  updatedById String?

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  products Product[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([tenantId, factusTaxCode])
  @@map("tax_categories")
}

model ProductRecipe {
  id        String  @id @default(cuid())
  tenantId  String
  productId String
  isActive  Boolean @default(true)

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  createdById String?
  updatedById String?

  tenant      Tenant                    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  product     Product                   @relation(fields: [productId], references: [id], onDelete: Cascade)
  ingredients ProductRecipeIngredient[]

  @@unique([tenantId, productId])
  @@index([tenantId])
  @@index([tenantId, isActive])
  @@map("product_recipes")
}

model ProductRecipeIngredient {
  id           String @id @default(cuid())
  tenantId     String
  recipeId     String
  ingredientId String
  quantity     Int

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String?
  updatedById String?

  tenant     Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  recipe     ProductRecipe       @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  ingredient InventoryIngredient @relation(fields: [ingredientId], references: [id], onDelete: Restrict)

  @@unique([tenantId, recipeId, ingredientId])
  @@index([tenantId])
  @@index([ingredientId])
  @@map("product_recipe_ingredients")
}

/// Colombian fiscal configuration per tenant. This stores readiness metadata,
/// not a legal claim of DIAN certification.
model FiscalProfile {
  id       String @id @default(cuid())
  tenantId String @unique

  legalName              String
  nit                    String
  taxRegime              String?
  fiscalResponsibilities String[] @default([])
  countryCode            String   @default("CO")
  municipality           String?
  municipalityCode       String?
  address                String?
  email                  String?
  phone                  String?
  dv                     String?

  invoiceResolutionNumber    String?
  invoiceResolutionPrefix    String?
  numberingRangeFrom         Int?
  numberingRangeTo           Int?
  numberingValidFrom         DateTime?
  numberingValidUntil        DateTime?
  numberingRangeId           Int?
  creditNoteNumberingRangeId Int?

  isReady Boolean @default(false)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String?
  updatedById String?

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invoices Invoice[]

  @@index([tenantId])
  @@map("fiscal_profiles")
}

/// Encrypted provider credentials are isolated per tenant. The renderer only
/// receives a masked connection state; plaintext never leaves the backend.
model FactusConnection {
  id                   String                 @id @default(cuid())
  tenantId             String                 @unique
  environment          FactusEnvironment      @default(SANDBOX)
  baseUrl              String
  encryptedCredentials String
  status               FactusConnectionStatus @default(PENDING_VERIFICATION)
  lastVerifiedAt       DateTime?
  lastLatencyMs        Int?
  lastErrorCode        String?
  lastErrorMessage     String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String?
  updatedById String?

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([status])
  @@map("factus_connections")
}

/// A single issuer belongs to the tenant; every issuing branch selects its
/// own approved range and establishment data from that issuer.
model BranchFiscalConfiguration {
  id       String @id @default(cuid())
  tenantId String
  branchId String @unique

  establishmentName         String?
  establishmentCode         String?
  establishmentAddress      String?
  establishmentMunicipality String?
  establishmentPhone        String?

  invoiceNumberingRangeId    Int?
  creditNoteNumberingRangeId Int?
  supportNumberingRangeId    Int?
  adjustmentNumberingRangeId Int?
  isEnabled                  Boolean @default(false)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String?
  updatedById String?

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([tenantId, branchId])
  @@index([tenantId])
  @@index([tenantId, isEnabled])
  @@map("branch_fiscal_configurations")
}

/// A transactional outbox makes provider submission recoverable after the
/// sale closes. It contains frozen payload data, never secrets.
model FiscalOutboxEvent {
  id             String             @id @default(cuid())
  tenantId       String
  branchId       String?
  invoiceId      String?
  documentType   String
  aggregateId    String
  idempotencyKey String
  payload        Json
  status         FiscalOutboxStatus @default(PENDING)
  attemptCount   Int                @default(0)
  availableAt    DateTime           @default(now())
  lockedAt       DateTime?
  completedAt    DateTime?
  lastError      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant  Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch  Branch?  @relation(fields: [branchId], references: [id], onDelete: SetNull)
  invoice Invoice? @relation(fields: [invoiceId], references: [id], onDelete: SetNull)

  @@unique([tenantId, documentType, idempotencyKey])
  @@index([status, availableAt])
  @@index([tenantId, branchId])
  @@index([invoiceId])
  @@map("fiscal_outbox_events")
}

/// Fiscal document lifecycle. POS can create drafts later; provider-specific
/// submission stays isolated in fiscal application services.
model Invoice {
  id       String  @id @default(cuid())
  tenantId String
  branchId String?

  fiscalProfileId String?
  saleId          String?
  customerId      String?
  documentType    String  @default("INVOICE")

  prefix String?
  number Int?
  status FiscalInvoiceStatus @default(DRAFT)

  customerDocumentType          String?
  customerDocumentNumber        String?
  customerDv                    String?
  customerIdentificationCode    String?
  customerLegalOrganizationCode String?
  customerCompany               String?
  customerNames                 String?
  customerName                  String
  customerEmail                 String?
  customerPhone                 String?
  customerAddress               String?
  customerCountryCode           String?
  customerMunicipality          String?
  customerMunicipalityCode      String?
  customerTributeCode           String?

  subtotalAmount Int    @default(0)
  taxAmount      Int    @default(0)
  discountAmount Int    @default(0)
  totalAmount    Int    @default(0)
  currency       String @default("COP")

  providerType                FiscalProviderType?
  providerName                String?
  externalReference           String?
  referenceCode               String?
  numberingRangeId            Int?
  factusNumber                String?
  factusId                    String?
  cufe                        String?
  cude                        String?
  qrUrl                       String?
  publicUrl                   String?
  xmlUrl                      String?
  pdfUrl                      String?
  pdfBase64                   String?
  pdfFileName                 String?
  xmlBase64                   String?
  xmlFileName                 String?
  attachedDocumentXmlBase64   String?
  attachedDocumentXmlFileName String?
  providerPayload             Json?
  rejectionPayload            Json?
  isValidated                 Boolean             @default(false)
  lastErrorCode               String?
  retryCount                  Int                 @default(0)
  lastAttemptAt               DateTime?
  nextRetryAt                 DateTime?

  sentAt      DateTime?
  acceptedAt  DateTime?
  validatedAt DateTime?
  rejectedAt  DateTime?
  cancelledAt DateTime?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  createdById String?
  updatedById String?

  tenant         Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch         Branch?             @relation(fields: [branchId], references: [id], onDelete: SetNull)
  fiscalProfile  FiscalProfile?      @relation(fields: [fiscalProfileId], references: [id], onDelete: SetNull)
  customer       Customer?           @relation(fields: [customerId], references: [id], onDelete: SetNull)
  sale           Sale?               @relation("SaleInvoices", fields: [saleId], references: [id], onDelete: SetNull)
  primaryForSale Sale?               @relation("SalePrimaryFiscalDocument")
  lines          InvoiceLine[]
  taxes          InvoiceTax[]
  events         InvoiceEvent[]
  dianResponses  DianResponse[]
  outboxEvents   FiscalOutboxEvent[]
  creditNotes    CreditNote[]        @relation("InvoiceCreditNotes")
  debitNotes     DebitNote[]         @relation("InvoiceDebitNotes")

  @@unique([tenantId, prefix, number])
  @@unique([tenantId, referenceCode])
  @@unique([tenantId, saleId])
  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, saleId])
  @@index([tenantId, factusNumber])
  @@index([branchId])
  @@map("invoices")
}

model InvoiceLine {
