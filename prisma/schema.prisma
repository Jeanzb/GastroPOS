  factusTaxCode      String  @default("01")
  taxRateBasisPoints Int
  taxableAmount      Int
  taxAmount          Int
  isTaxExcluded      Boolean @default(false)

  createdAt DateTime @default(now())

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([invoiceId])
  @@map("invoice_taxes")
}

model InvoiceEvent {
  id        String @id @default(cuid())
  tenantId  String
