// GastroAI data model.
// Multi-tenant rule (AGENTS.md §6.2, §7): every business record carries a
// tenantId and audit fields. Tenant isolation is enforced in repositories.

generator client {
  provider = "prisma-client-js"
  output   = "../apps/api/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Default RBAC roles (AGENTS.md §6.3). Granular permissions come later.
enum UserRole {
  OWNER
  ADMIN
  CASHIER
  WAITER
  KITCHEN
  INVENTORY_MANAGER
  ACCOUNTANT
}

enum FiscalProviderType {
  DIAN_DIRECT
  TECHNOLOGY_PROVIDER
  API_PROVIDER
}

enum FiscalEnvironment {
  TEST
  PRODUCTION
}

enum FiscalProviderStatus {
  NOT_CONFIGURED
  CONFIGURED
  CONNECTION_TESTED
  ERROR
}

enum FiscalInvoiceStatus {
  DRAFT
  READY_TO_SEND
  SENT
  ACCEPTED
  REJECTED
  CANCELLED
  FAILED
}

enum FiscalInvoiceEventType {
  CREATED
  READY_TO_SEND
  SUBMITTED
  ACCEPTED
  REJECTED
  FAILED
  RETRY_REQUESTED
  CANCELLED
  PROVIDER_SYNCED
}

/// A restaurant business. Root of tenant isolation.
model Tenant {
  id       String  @id @default(cuid())
  name     String
  slug     String  @unique
  isActive Boolean @default(true)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  settings          TenantSettings?
  branches          Branch[]
  users             User[]
  sessions          Session[]
  productCategories ProductCategory[]
  products          Product[]
  fiscalProfile     FiscalProfile?
  fiscalProviders   FiscalProviderConfig[]
  invoices          Invoice[]

  @@map("tenants")
}

/// Per-tenant configuration that business logic must not hardcode.
model TenantSettings {
  id                 String  @id @default(cuid())
  tenantId           String  @unique
  currency           String  @default("COP")
  timezone           String  @default("America/Bogota")
  allowNegativeStock Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("tenant_settings")
}

/// A physical location / sede of a tenant.
model Branch {
  id       String  @id @default(cuid())
  tenantId String
  name     String
  code     String
  address  String?
  phone    String?
  isActive Boolean @default(true)

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  createdById String?
  updatedById String?

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  users    User[]
  sessions Session[]
  invoices Invoice[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("branches")
}

/// A staff account scoped to a single tenant.
model User {
  id           String    @id @default(cuid())
  tenantId     String
  branchId     String?
  email        String
  passwordHash String
  fullName     String
  role         UserRole  @default(CASHIER)
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  createdById String?
  updatedById String?

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch   Branch?   @relation(fields: [branchId], references: [id], onDelete: SetNull)
  sessions Session[]

  @@unique([tenantId, email])
  @@index([tenantId])
  @@index([branchId])
  @@map("users")
}

/// Authenticated device/browser session for a staff user.
model Session {
  id       String  @id @default(cuid())
  tenantId String
  branchId String?
  userId   String

  isActive  Boolean   @default(true)
  expiresAt DateTime
  revokedAt DateTime?

  ipAddress String?
  userAgent String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch        Branch?        @relation(fields: [branchId], references: [id], onDelete: SetNull)
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokens RefreshToken[]

  @@index([tenantId])
  @@index([userId])
  @@index([branchId])
  @@index([expiresAt])
  @@map("sessions")
}

/// Refresh token secret hash. The public token id is the record id.
model RefreshToken {
  id        String @id @default(cuid())
  sessionId String
  tokenHash String
  familyId  String

  expiresAt         DateTime
  revokedAt         DateTime?
  replacedByTokenId String?

  createdAt DateTime @default(now())

  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([familyId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

/// Immutable trail of business-critical actions.
model AuditLog {
  id          String  @id @default(cuid())
  tenantId    String?
  branchId    String?
  actorUserId String?
  action      String
  entityType  String
  entityId    String?

  before   Json?
  after    Json?
  metadata Json?

  ipAddress String?
  userAgent String?
  requestId String?

  createdAt DateTime @default(now())

  @@index([tenantId, createdAt])
  @@index([tenantId, entityType, entityId])
  @@index([actorUserId])
  @@map("audit_logs")
}

/// Grouping of catalog products (menu sections).
model ProductCategory {
  id        String  @id @default(cuid())
  tenantId  String
  name      String
  sortOrder Int     @default(0)
  isActive  Boolean @default(true)

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  createdById String?
  updatedById String?

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  products Product[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@index([tenantId, isActive])
  @@map("product_categories")
}

/// A sellable and/or inventoried catalog item.
/// Money is stored in integer minor units (COP has no decimals); never float.
model Product {
  id          String  @id @default(cuid())
  tenantId    String
  categoryId  String?
  sku         String?
  name        String
  description String?

  priceAmount Int    @default(0)
  currency    String @default("COP")

  isActive      Boolean @default(true)
  isSellable    Boolean @default(true)
  isInventoried Boolean @default(false)

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  createdById String?
  updatedById String?

  tenant   Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  category ProductCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@unique([tenantId, sku])
  @@index([tenantId])
  @@index([tenantId, categoryId])
  @@index([tenantId, isActive])
  @@map("products")
}

/// Colombian fiscal configuration per tenant. This stores readiness metadata,
/// not a legal claim of DIAN certification.
model FiscalProfile {
  id       String @id @default(cuid())
  tenantId String @unique

  legalName              String
  nit                    String
  taxRegime              String?
  fiscalResponsibilities String[] @default([])
  municipality           String?
  address                String?

  invoiceResolutionNumber String?
  invoiceResolutionPrefix String?
  numberingRangeFrom      Int?
  numberingRangeTo        Int?
  numberingValidFrom      DateTime?
  numberingValidUntil     DateTime?

  isReady Boolean @default(false)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String?
  updatedById String?

  tenant         Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  providerConfig FiscalProviderConfig?
  invoices       Invoice[]

  @@index([tenantId])
  @@map("fiscal_profiles")
}

/// External fiscal integration metadata. Store secret references here, not raw
/// certificates, API keys, or provider passwords.
model FiscalProviderConfig {
  id              String @id @default(cuid())
  tenantId        String
  fiscalProfileId String @unique

  providerType FiscalProviderType
  providerName String?
  environment  FiscalEnvironment    @default(TEST)
  status       FiscalProviderStatus @default(CONFIGURED)

  endpointUrl      String?
  softwareId       String?
  certificateAlias String?
  accountId        String?
  apiKeyRef        String?

  lastConnectionTestAt DateTime?
  lastConnectionError  String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String?
  updatedById String?

  tenant        Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  fiscalProfile FiscalProfile @relation(fields: [fiscalProfileId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([tenantId, status])
  @@map("fiscal_provider_configs")
}

/// Fiscal document lifecycle. POS can create drafts later; provider-specific
/// submission stays isolated in fiscal application services.
model Invoice {
  id       String  @id @default(cuid())
  tenantId String
  branchId String?

  fiscalProfileId String?
  saleId          String?
  documentType    String  @default("INVOICE")

  prefix String?
  number Int?
  status FiscalInvoiceStatus @default(DRAFT)

  customerDocumentType   String?
  customerDocumentNumber String?
  customerName           String
  customerEmail          String?
  customerPhone          String?
  customerAddress        String?
  customerMunicipality   String?

  subtotalAmount Int    @default(0)
  taxAmount      Int    @default(0)
  discountAmount Int    @default(0)
  totalAmount    Int    @default(0)
  currency       String @default("COP")

  providerType      FiscalProviderType?
  providerName      String?
  externalReference String?
  cufe              String?
  cude              String?
  qrUrl             String?
  xmlUrl            String?
  pdfUrl            String?
  providerPayload   Json?
  rejectionPayload  Json?

  sentAt      DateTime?
  acceptedAt  DateTime?
  cancelledAt DateTime?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  createdById String?
  updatedById String?

  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch        Branch?        @relation(fields: [branchId], references: [id], onDelete: SetNull)
  fiscalProfile FiscalProfile? @relation(fields: [fiscalProfileId], references: [id], onDelete: SetNull)
  lines         InvoiceLine[]
  taxes         InvoiceTax[]
  events        InvoiceEvent[]

  @@unique([tenantId, prefix, number])
  @@index([tenantId])
  @@index([tenantId, status])
  @@index([branchId])
  @@map("invoices")
}

model InvoiceLine {
  id        String  @id @default(cuid())
  tenantId  String
  invoiceId String
  productId String?

  description     String
  quantity        Int
  unitPriceAmount Int
  subtotalAmount  Int
  taxAmount       Int    @default(0)
  totalAmount     Int
  currency        String @default("COP")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([invoiceId])
  @@map("invoice_lines")
}

model InvoiceTax {
  id        String @id @default(cuid())
  tenantId  String
  invoiceId String

  taxName            String
  taxRateBasisPoints Int
  taxableAmount      Int
  taxAmount          Int

  createdAt DateTime @default(now())

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([invoiceId])
  @@map("invoice_taxes")
}

model InvoiceEvent {
  id        String @id @default(cuid())
  tenantId  String
  invoiceId String

  type              FiscalInvoiceEventType
  status            FiscalInvoiceStatus?
  message           String?
  payload           Json?
  providerReference String?

  createdById String?
  createdAt   DateTime @default(now())

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([invoiceId])
  @@index([tenantId, createdAt])
  @@map("invoice_events")
}
