// GastroAI data model.
// Multi-tenant rule (AGENTS.md §6.2, §7): every business record carries a
// tenantId and audit fields. Tenant isolation is enforced in repositories.

generator client {
  provider = "prisma-client-js"
  output   = "../apps/api/src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Default RBAC roles (AGENTS.md §6.3). Granular permissions come later.
enum UserRole {
  OWNER
  ADMIN
  CASHIER
  WAITER
  KITCHEN
  INVENTORY_MANAGER
  ACCOUNTANT
}

/// A restaurant business. Root of tenant isolation.
model Tenant {
  id       String  @id @default(cuid())
  name     String
  slug     String  @unique
  isActive Boolean @default(true)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  settings TenantSettings?
  branches Branch[]
  users    User[]
  sessions Session[]

  @@map("tenants")
}

/// Per-tenant configuration that business logic must not hardcode.
model TenantSettings {
  id                 String  @id @default(cuid())
  tenantId           String  @unique
  currency           String  @default("COP")
  timezone           String  @default("America/Bogota")
  allowNegativeStock Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("tenant_settings")
}

/// A physical location / sede of a tenant.
model Branch {
  id       String  @id @default(cuid())
  tenantId String
  name     String
  code     String
  address  String?
  phone    String?
  isActive Boolean @default(true)

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  createdById String?
  updatedById String?

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  users  User[]
  sessions Session[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("branches")
}

/// A staff account scoped to a single tenant.
model User {
  id           String    @id @default(cuid())
  tenantId     String
  branchId     String?
  email        String
  passwordHash String
  fullName     String
  role         UserRole  @default(CASHIER)
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  createdById String?
  updatedById String?

  tenant Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch Branch? @relation(fields: [branchId], references: [id], onDelete: SetNull)
  sessions Session[]

  @@unique([tenantId, email])
  @@index([tenantId])
  @@index([branchId])
  @@map("users")
}

/// Authenticated device/browser session for a staff user.
model Session {
  id       String  @id @default(cuid())
  tenantId String
  branchId String?
  userId   String

  isActive  Boolean   @default(true)
  expiresAt DateTime
  revokedAt DateTime?

  ipAddress String?
  userAgent String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch Branch? @relation(fields: [branchId], references: [id], onDelete: SetNull)
  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokens RefreshToken[]

  @@index([tenantId])
  @@index([userId])
  @@index([branchId])
  @@index([expiresAt])
  @@map("sessions")
}

/// Refresh token secret hash. The public token id is the record id.
model RefreshToken {
  id        String @id @default(cuid())
  sessionId String
  tokenHash String
  familyId  String

  expiresAt DateTime
  revokedAt DateTime?
  replacedByTokenId String?

  createdAt DateTime @default(now())

  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([familyId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

/// Immutable trail of business-critical actions.
model AuditLog {
  id          String  @id @default(cuid())
  tenantId    String?
  branchId    String?
  actorUserId String?
  action      String
  entityType  String
  entityId    String?

  before   Json?
  after    Json?
  metadata Json?

  ipAddress String?
  userAgent String?
  requestId String?

  createdAt DateTime @default(now())

  @@index([tenantId, createdAt])
  @@index([tenantId, entityType, entityId])
  @@index([actorUserId])
  @@map("audit_logs")
}
