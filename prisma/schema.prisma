  subtotalAmount              Int                 @default(0)
  taxAmount                   Int                 @default(0)
  discountAmount              Int                 @default(0)
  tipAmount                   Int                 @default(0)
  amount                      Int                 @default(0)
  currency                    String              @default("COP")
  status                      FiscalInvoiceStatus @default(DRAFT)
  factusNumber                String?
  factusId                    String?
  cude                        String?
  qrUrl                       String?
  publicUrl                   String?
  pdfBase64                   String?
  pdfFileName                 String?
  xmlBase64                   String?
  xmlFileName                 String?
  attachedDocumentXmlBase64   String?
  attachedDocumentXmlFileName String?
  providerPayload             Json?
  rejectionPayload            Json?
  isValidated                 Boolean             @default(false)
  lastErrorCode               String?
