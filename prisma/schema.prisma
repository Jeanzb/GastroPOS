// GastroAI data model.
// Multi-tenant rule (AGENTS.md §6.2, §7): every business record carries a
// tenantId and audit fields. Tenant isolation is enforced in repositories.

generator client {
  provider = "prisma-client-js"
  output   = "../apps/api/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Default RBAC roles (AGENTS.md §6.3). Granular permissions come later.
enum UserRole {
  OWNER
  ADMIN
  CASHIER
  WAITER
  KITCHEN
  INVENTORY_MANAGER
  ACCOUNTANT
}

enum AuthScope {
  TENANT
  POS
  PLATFORM
}

enum PlatformRole {
  PLATFORM_OWNER
  PLATFORM_ADMIN
  SUPPORT_AGENT
}

enum TenantStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  SUSPENDED
  CANCELLED
  ARCHIVED
}

enum FiscalProviderType {
  DIAN_DIRECT
  TECHNOLOGY_PROVIDER
  API_PROVIDER
}

enum FiscalEnvironment {
  TEST
  PRODUCTION
}

enum FiscalProviderStatus {
  NOT_CONFIGURED
  CONFIGURED
  CONNECTION_TESTED
  ERROR
}

enum FiscalInvoiceStatus {
  DRAFT
  READY_TO_SEND
  SENT
  ACCEPTED
  REJECTED
  CANCELLED
  FAILED
}

enum FiscalInvoiceEventType {
  CREATED
  READY_TO_SEND
  SUBMITTED
  ACCEPTED
  REJECTED
  FAILED
  RETRY_REQUESTED
  CANCELLED
  PROVIDER_SYNCED
}

/// A restaurant business. Root of tenant isolation.
model Tenant {
  id       String  @id @default(cuid())
  name     String
  slug     String  @unique
  isActive Boolean @default(true)
  status   TenantStatus @default(ACTIVE)

  planId           String?
  trialEndsAt      DateTime?
  suspendedAt      DateTime?
  cancelledAt      DateTime?
  archivedAt       DateTime?
  suspensionReason String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  plan              Plan?              @relation(fields: [planId], references: [id], onDelete: SetNull)
  settings          TenantSettings?
  branches          Branch[]
  users             User[]
  sessions          Session[]
  featureOverrides  TenantFeatureOverride[]
  productCategories ProductCategory[]
  products          Product[]
  fiscalProfile     FiscalProfile?
  fiscalProviders   FiscalProviderConfig[]
  invoices          Invoice[]
  cashSessions      CashSession[]
  cashMovements     CashMovement[]
  sales             Sale[]
  saleItems         SaleItem[]
  payments          Payment[]
  customers         Customer[]
  suppliers         Supplier[]
  purchases         Purchase[]
  purchaseItems     PurchaseItem[]
  unitsOfMeasure        UnitOfMeasure[]
  inventoryCategories   InventoryCategory[]
  inventoryIngredients  InventoryIngredient[]
  inventorySkuSequences InventorySkuSequence[]
  inventoryBalances     InventoryBalance[]
  stockMovements        StockMovement[]
  diningZones       DiningZone[]
  diningTables      DiningTable[]

  @@index([planId])
  @@index([status])
  @@index([deletedAt])
  @@index([status, deletedAt])
  @@map("tenants")
}

model PlatformUser {
  id           String       @id @default(cuid())
  email        String       @unique
  passwordHash String
  fullName     String
  role         PlatformRole @default(PLATFORM_ADMIN)
  isActive     Boolean      @default(true)
  lastLoginAt  DateTime?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  createdById String?
  updatedById String?

  sessions PlatformSession[]

  @@index([isActive])
  @@map("platform_users")
}

model PlatformSession {
  id             String @id @default(cuid())
  platformUserId String

  isActive  Boolean   @default(true)
  expiresAt DateTime
  revokedAt DateTime?

  ipAddress String?
  userAgent String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user          PlatformUser           @relation(fields: [platformUserId], references: [id], onDelete: Cascade)
  refreshTokens PlatformRefreshToken[]

  @@index([platformUserId])
  @@index([platformUserId, isActive])
  @@index([expiresAt])
  @@map("platform_sessions")
}

model PlatformRefreshToken {
  id                String @id @default(cuid())
  platformSessionId String
  tokenHash         String
  familyId          String

  expiresAt         DateTime
  revokedAt         DateTime?
  replacedByTokenId String?

  createdAt DateTime @default(now())

  session PlatformSession @relation(fields: [platformSessionId], references: [id], onDelete: Cascade)

  @@index([platformSessionId])
  @@index([familyId])
  @@index([expiresAt])
  @@map("platform_refresh_tokens")
}

model Plan {
  id          String  @id @default(cuid())
  code        String  @unique
  name        String
  description String?
  isActive    Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenants  Tenant[]
  features PlanFeature[]

  @@index([isActive])
  @@map("plans")
}

model Feature {
  id          String  @id @default(cuid())
  code        String  @unique
  name        String
  description String?
  isActive    Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  plans           PlanFeature[]
  tenantOverrides TenantFeatureOverride[]

  @@index([isActive])
  @@map("features")
}

model PlanFeature {
  id        String @id @default(cuid())
  planId    String
  featureId String
  enabled   Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  plan    Plan    @relation(fields: [planId], references: [id], onDelete: Cascade)
  feature Feature @relation(fields: [featureId], references: [id], onDelete: Cascade)

  @@unique([planId, featureId])
  @@index([planId])
  @@index([featureId])
  @@map("plan_features")
}

model TenantFeatureOverride {
  id        String @id @default(cuid())
  tenantId  String
  featureId String
  enabled   Boolean
  reason    String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String?
  updatedById String?

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  feature Feature @relation(fields: [featureId], references: [id], onDelete: Cascade)

  @@unique([tenantId, featureId])
  @@index([tenantId])
  @@index([featureId])
  @@map("tenant_feature_overrides")
}

/// Per-tenant configuration that business logic must not hardcode.
model TenantSettings {
  id                 String  @id @default(cuid())
  tenantId           String  @unique
  currency           String  @default("COP")
  timezone           String  @default("America/Bogota")
  allowNegativeStock Boolean @default(false)
  // Local hour (0-23) when the business day rolls over; operational POS sessions are force-closed at this hour.
  businessDayStartsAtHour Int @default(4)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("tenant_settings")
}

/// A physical location / sede of a tenant.
model Branch {
  id       String  @id @default(cuid())
  tenantId String
  name     String
  code     String
  address  String?
  phone    String?
  isActive Boolean @default(true)

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  createdById String?
  updatedById String?

  tenant         Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  users          User[]
  sessions       Session[]
  invoices       Invoice[]
  cashSessions   CashSession[]
  sales          Sale[]
  purchases      Purchase[]
  inventoryBalances InventoryBalance[]
  stockMovements StockMovement[]
  diningZones    DiningZone[]
  diningTables   DiningTable[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([tenantId, deletedAt])
  @@index([tenantId, isActive])
  @@map("branches")
}

enum DiningTableStatus {
  FREE
  OCCUPIED
  PENDING_BILL
  RESERVED
}

/// Physical zone inside a restaurant branch, such as main dining room or terrace.
model DiningZone {
  id       String @id @default(cuid())
  tenantId String
  branchId String

  name      String
  sortOrder Int     @default(0)
  isActive  Boolean @default(true)

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  createdById String?
  updatedById String?

  tenant Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch Branch        @relation(fields: [branchId], references: [id], onDelete: Cascade)
  tables DiningTable[]

  @@index([tenantId])
  @@index([tenantId, branchId])
  @@index([tenantId, branchId, name])
  @@map("dining_zones")
}

/// A billable physical table. POS/order linkage will attach to this table later.
model DiningTable {
  id       String @id @default(cuid())
  tenantId String
  branchId String
  zoneId   String

  number String
  seats  Int               @default(4)
  status DiningTableStatus @default(FREE)

  waiterName      String?
  openedAt        DateTime?
  reservationName String?
  reservationTime String?
  notes           String?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  createdById String?
  updatedById String?

  tenant Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch Branch     @relation(fields: [branchId], references: [id], onDelete: Cascade)
  zone   DiningZone @relation(fields: [zoneId], references: [id], onDelete: Restrict)
  sales  Sale[]

  @@index([tenantId])
  @@index([tenantId, branchId])
  @@index([tenantId, branchId, number])
  @@index([zoneId])
  @@index([tenantId, branchId, status])
  @@map("dining_tables")
}

/// A staff account scoped to a single tenant.
model User {
  id           String    @id @default(cuid())
  tenantId     String
  branchId     String?
  email        String
  passwordHash String
  fullName     String
  // National ID (cédula). Unique per tenant; used as the staff POS login identifier.
  documentNumber String?
  role         UserRole  @default(CASHIER)
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?

  // Fast POS terminal login. PIN is hashed; uniqueness per branch is enforced in app logic.
  pinHash           String?
  pinUpdatedAt      DateTime?
  failedPinAttempts Int       @default(0)
  pinLockedUntil    DateTime?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  createdById String?
  updatedById String?

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch   Branch?   @relation(fields: [branchId], references: [id], onDelete: SetNull)
  sessions Session[]

  @@unique([tenantId, email])
  @@unique([tenantId, documentNumber])
  @@index([tenantId])
  @@index([branchId])
  @@index([branchId, isActive])
  @@index([branchId, documentNumber])
  @@map("users")
}

/// Authenticated device/browser session for a staff user.
model Session {
  id       String  @id @default(cuid())
  tenantId String
  branchId String?
  userId   String
  authScope AuthScope @default(TENANT)

  isActive  Boolean   @default(true)
  expiresAt DateTime
  revokedAt DateTime?

  ipAddress String?
  userAgent String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch        Branch?        @relation(fields: [branchId], references: [id], onDelete: SetNull)
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokens RefreshToken[]

  @@index([tenantId])
  @@index([tenantId, branchId])
  @@index([userId])
  @@index([branchId])
  @@index([isActive, expiresAt])
  @@index([expiresAt])
  @@map("sessions")
}

/// Refresh token secret hash. The public token id is the record id.
model RefreshToken {
  id        String @id @default(cuid())
  sessionId String
  tokenHash String
  familyId  String

  expiresAt         DateTime
  revokedAt         DateTime?
  replacedByTokenId String?

  createdAt DateTime @default(now())

  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([familyId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

/// Immutable trail of business-critical actions.
model AuditLog {
  id          String  @id @default(cuid())
  tenantId    String?
  branchId    String?
  actorUserId String?
  action      String
  entityType  String
  entityId    String?

  before   Json?
  after    Json?
  metadata Json?

  ipAddress String?
  userAgent String?
  requestId String?

  createdAt DateTime @default(now())

  @@index([tenantId, createdAt])
  @@index([tenantId, entityType, entityId])
  @@index([actorUserId])
  @@map("audit_logs")
}

/// Grouping of catalog products (menu sections).
model ProductCategory {
  id        String  @id @default(cuid())
  tenantId  String
  name      String
  sortOrder Int     @default(0)
  isActive  Boolean @default(true)

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  createdById String?
  updatedById String?

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  products Product[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@index([tenantId, isActive])
  @@map("product_categories")
}

/// A sellable and/or inventoried catalog item.
/// Money is stored in integer minor units (COP has no decimals); never float.
model Product {
  id          String  @id @default(cuid())
  tenantId    String
  categoryId  String?
  sku         String?
  name        String
  description String?

  priceAmount Int    @default(0)
  currency    String @default("COP")

  isActive      Boolean @default(true)
  isSellable    Boolean @default(true)
  isInventoried Boolean @default(false)

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  createdById String?
  updatedById String?

  tenant         Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  category       ProductCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  saleItems      SaleItem[]
  purchaseItems  PurchaseItem[]
  inventoryIngredients InventoryIngredient[]

  @@unique([tenantId, sku])
  @@index([tenantId])
  @@index([tenantId, categoryId])
  @@index([tenantId, isActive])
  @@map("products")
}

/// Colombian fiscal configuration per tenant. This stores readiness metadata,
/// not a legal claim of DIAN certification.
model FiscalProfile {
  id       String @id @default(cuid())
  tenantId String @unique

  legalName              String
  nit                    String
  taxRegime              String?
  fiscalResponsibilities String[] @default([])
  municipality           String?
  address                String?

  invoiceResolutionNumber String?
  invoiceResolutionPrefix String?
  numberingRangeFrom      Int?
  numberingRangeTo        Int?
  numberingValidFrom      DateTime?
  numberingValidUntil     DateTime?

  isReady Boolean @default(false)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String?
  updatedById String?

  tenant         Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  providerConfig FiscalProviderConfig?
  invoices       Invoice[]

  @@index([tenantId])
  @@map("fiscal_profiles")
}

/// External fiscal integration metadata. Store secret references here, not raw
/// certificates, API keys, or provider passwords.
model FiscalProviderConfig {
  id              String @id @default(cuid())
  tenantId        String
  fiscalProfileId String @unique

  providerType FiscalProviderType
  providerName String?
  environment  FiscalEnvironment    @default(TEST)
  status       FiscalProviderStatus @default(CONFIGURED)

  endpointUrl      String?
  softwareId       String?
  certificateAlias String?
  accountId        String?
  apiKeyRef        String?

  lastConnectionTestAt DateTime?
  lastConnectionError  String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String?
  updatedById String?

  tenant        Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  fiscalProfile FiscalProfile @relation(fields: [fiscalProfileId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([tenantId, status])
  @@map("fiscal_provider_configs")
}

/// Fiscal document lifecycle. POS can create drafts later; provider-specific
/// submission stays isolated in fiscal application services.
model Invoice {
  id       String  @id @default(cuid())
  tenantId String
  branchId String?

  fiscalProfileId String?
  saleId          String?
  customerId      String?
  documentType    String  @default("INVOICE")

  prefix String?
  number Int?
  status FiscalInvoiceStatus @default(DRAFT)

  customerDocumentType   String?
  customerDocumentNumber String?
  customerName           String
  customerEmail          String?
  customerPhone          String?
  customerAddress        String?
  customerMunicipality   String?

  subtotalAmount Int    @default(0)
  taxAmount      Int    @default(0)
  discountAmount Int    @default(0)
  totalAmount    Int    @default(0)
  currency       String @default("COP")

  providerType      FiscalProviderType?
  providerName      String?
  externalReference String?
  cufe              String?
  cude              String?
  qrUrl             String?
  xmlUrl            String?
  pdfUrl            String?
  providerPayload   Json?
  rejectionPayload  Json?

  sentAt      DateTime?
  acceptedAt  DateTime?
  cancelledAt DateTime?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  createdById String?
  updatedById String?

  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch        Branch?        @relation(fields: [branchId], references: [id], onDelete: SetNull)
  fiscalProfile FiscalProfile? @relation(fields: [fiscalProfileId], references: [id], onDelete: SetNull)
  customer      Customer?      @relation(fields: [customerId], references: [id], onDelete: SetNull)
  lines         InvoiceLine[]
  taxes         InvoiceTax[]
  events        InvoiceEvent[]

  @@unique([tenantId, prefix, number])
  @@index([tenantId])
  @@index([tenantId, status])
  @@index([branchId])
  @@map("invoices")
}

model InvoiceLine {
  id        String  @id @default(cuid())
  tenantId  String
  invoiceId String
  productId String?

  description     String
  quantity        Int
  unitPriceAmount Int
  subtotalAmount  Int
  taxAmount       Int    @default(0)
  totalAmount     Int
  currency        String @default("COP")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([invoiceId])
  @@map("invoice_lines")
}

model InvoiceTax {
  id        String @id @default(cuid())
  tenantId  String
  invoiceId String

  taxName            String
  taxRateBasisPoints Int
  taxableAmount      Int
  taxAmount          Int

  createdAt DateTime @default(now())

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([invoiceId])
  @@map("invoice_taxes")
}

model InvoiceEvent {
  id        String @id @default(cuid())
  tenantId  String
  invoiceId String

  type              FiscalInvoiceEventType
  status            FiscalInvoiceStatus?
  message           String?
  payload           Json?
  providerReference String?

  createdById String?
  createdAt   DateTime @default(now())

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([invoiceId])
  @@index([tenantId, createdAt])
  @@map("invoice_events")
}

enum CashSessionStatus {
  OPEN
  CLOSED
}

enum CashMovementType {
  OPENING_BALANCE
  CASH_IN
  CASH_OUT
  SALE_PAYMENT
  REFUND
  TIP
  ADJUSTMENT
}

/// A cash register session for a branch: opened with a balance, closed with a count.
/// Money is stored in integer minor units; never float.
model CashSession {
  id       String            @id @default(cuid())
  tenantId String
  branchId String
  status   CashSessionStatus @default(OPEN)
  currency String            @default("COP")

  openingBalance Int     @default(0)
  expectedAmount Int?
  countedAmount  Int?
  difference     Int?
  notes          String?

  openedById String
  closedById String?
  openedAt   DateTime  @default(now())
  closedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant    Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch    Branch         @relation(fields: [branchId], references: [id], onDelete: Cascade)
  movements CashMovement[]
  sales     Sale[]

  @@index([tenantId])
  @@index([tenantId, branchId, status])
  @@map("cash_sessions")
}

/// An individual cash movement within a session.
model CashMovement {
  id            String           @id @default(cuid())
  tenantId      String
  branchId      String
  cashSessionId String
  type          CashMovementType
  amount        Int
  reference     String?
  notes         String?

  createdById String
  createdAt   DateTime @default(now())

  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  cashSession CashSession @relation(fields: [cashSessionId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([cashSessionId])
  @@map("cash_movements")
}

enum SaleStatus {
  DRAFT
  CLOSED
  CANCELLED
}

enum PaymentMethod {
  CASH
  CARD
  TRANSFER
  OTHER
}

/// A point-of-sale ticket. Closed sales are immutable except via cancellation.
/// All money is stored in integer minor units; never float.
model Sale {
  id            String     @id @default(cuid())
  tenantId      String
  branchId      String
  cashSessionId String?
  diningTableId String?
  customerId    String?
  status        SaleStatus @default(DRAFT)
  currency      String     @default("COP")

  guestCount Int?
  waiterName String?

  customerName    String?
  requiresInvoice Boolean @default(false)

  subtotal      Int @default(0)
  discountTotal Int @default(0)
  taxTotal      Int @default(0)
  grandTotal    Int @default(0)
  paidTotal     Int @default(0)

  notes        String?
  cancelReason String?

  createdById String
  closedById  String?
  closedAt    DateTime?
  cancelledAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch      Branch       @relation(fields: [branchId], references: [id], onDelete: Cascade)
  cashSession CashSession? @relation(fields: [cashSessionId], references: [id], onDelete: SetNull)
  diningTable DiningTable? @relation(fields: [diningTableId], references: [id], onDelete: SetNull)
  customer    Customer?    @relation(fields: [customerId], references: [id], onDelete: SetNull)
  items       SaleItem[]
  payments    Payment[]

  @@index([tenantId])
  @@index([tenantId, branchId, status])
  @@index([tenantId, diningTableId, status])
  @@index([cashSessionId])
  @@map("sales")
}

/// A line in a sale. Product name and unit price are snapshotted at sale time.
model SaleItem {
  id        String  @id @default(cuid())
  tenantId  String
  saleId    String
  productId String?

  nameSnapshot      String
  unitPriceSnapshot Int
  quantity          Int    @default(1)
  lineTotal         Int

  createdAt DateTime @default(now())

  tenant  Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sale    Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([saleId])
  @@map("sale_items")
}

/// A payment registered against a sale.
model Payment {
  id        String        @id @default(cuid())
  tenantId  String
  saleId    String
  method    PaymentMethod
  amount    Int
  reference String?

  createdById String
  createdAt   DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sale   Sale   @relation(fields: [saleId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([saleId])
  @@map("payments")
}

/// Colombian identification document types for customers (DIAN).
enum CustomerDocumentType {
  CC
  NIT
  CE
  PP
  TI
  NUIP
  OTHER
}

/// A customer registry with fiscal data for electronic invoicing (DIAN).
model Customer {
  id                String               @id @default(cuid())
  tenantId          String
  documentType      CustomerDocumentType @default(CC)
  documentNumber    String
  name              String
  email             String?
  phone             String?
  address           String?
  municipality      String?
  taxResponsibility String?
  isActive          Boolean              @default(true)

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  createdById String?
  updatedById String?

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invoices Invoice[]
  sales    Sale[]

  @@unique([tenantId, documentType, documentNumber])
  @@index([tenantId])
  @@index([tenantId, isActive])
  @@map("customers")
}

enum PurchaseStatus {
  DRAFT
  RECEIVED
  CANCELLED
}

enum StockMovementType {
  PURCHASE
  SALE_CONSUMPTION
  ADJUSTMENT_IN
  ADJUSTMENT_OUT
  WASTE
  TRANSFER_IN
  TRANSFER_OUT
  RETURN
}

/// A supplier/vendor the tenant buys from.
model Supplier {
  id             String  @id @default(cuid())
  tenantId       String
  name           String
  documentNumber String?
  email          String?
  phone          String?
  address        String?
  isActive       Boolean @default(true)

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  createdById String?
  updatedById String?

  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  purchases Purchase[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@index([tenantId, isActive])
  @@map("suppliers")
}

/// A purchase from a supplier. Receiving will feed inventory once it exists.
/// Money is stored in integer minor units; never float.
model Purchase {
  id         String         @id @default(cuid())
  tenantId   String
  branchId   String?
  supplierId String
  status     PurchaseStatus @default(DRAFT)
  currency   String         @default("COP")

  reference String?
  notes     String?

  subtotal Int @default(0)
  taxTotal Int @default(0)
  total    Int @default(0)

  receivedAt  DateTime?
  createdById String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  tenant         Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch         Branch?         @relation(fields: [branchId], references: [id], onDelete: SetNull)
  supplier       Supplier        @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  items          PurchaseItem[]
  stockMovements StockMovement[]

  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, createdAt])
  @@index([supplierId])
  @@map("purchases")
}

/// A line in a purchase. Product name and unit cost are snapshotted.
model PurchaseItem {
  id         String  @id @default(cuid())
  tenantId   String
  purchaseId String
  productId  String?

  nameSnapshot String
  quantity     Int
  unitCost     Int
  lineTotal    Int

  createdAt DateTime @default(now())

  tenant         Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  purchase       Purchase        @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  product        Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)
  stockMovements StockMovement[]

  @@index([tenantId])
  @@index([purchaseId])
  @@map("purchase_items")
}

/// Unit catalog used by inventory items. Conversions are explicit future work.
model UnitOfMeasure {
  id       String @id @default(cuid())
  tenantId String
  code     String
  name     String

  isActive Boolean @default(true)

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  createdById String?
  updatedById String?

  tenant         Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  inventoryIngredients InventoryIngredient[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([tenantId, isActive])
  @@map("unit_of_measures")
}

model InventoryCategory {
  id        String @id @default(cuid())
  tenantId  String
  code      String
  name      String
  skuPrefix String

  isActive Boolean @default(true)

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  createdById String?
  updatedById String?

  tenant      Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  ingredients InventoryIngredient[]

  @@unique([tenantId, code])
  @@unique([tenantId, skuPrefix])
  @@index([tenantId])
  @@index([tenantId, isActive])
  @@index([tenantId, deletedAt])
  @@map("inventory_categories")
}

model InventorySkuSequence {
  id         String @id @default(cuid())
  tenantId   String
  prefix     String
  nextNumber Int    @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, prefix])
  @@index([tenantId])
  @@map("inventory_sku_sequences")
}

/// Tenant-level ingredient catalog entry. Branch-specific stock lives in InventoryBalance.
model InventoryIngredient {
  id        String  @id @default(cuid())
  tenantId  String
  productId String?
  baseUnitId String
  categoryId String

  name               String
  sku                String
  isActive           Boolean @default(true)

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  createdById String?
  updatedById String?

  tenant    Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  product   Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)
  baseUnit  UnitOfMeasure   @relation(fields: [baseUnitId], references: [id], onDelete: Restrict)
  category  InventoryCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  balances  InventoryBalance[]
  movements StockMovement[]

  @@unique([tenantId, sku])
  @@index([tenantId])
  @@index([tenantId, productId])
  @@index([tenantId, categoryId])
  @@index([tenantId, isActive])
  @@map("inventory_ingredients")
}

/// Current inventory balance for an ingredient in a branch. Mutations must create movements.
model InventoryBalance {
  id           String @id @default(cuid())
  tenantId     String
  branchId     String
  ingredientId String

  stockOnHand        Int     @default(0)
  minimumStock       Int     @default(0)
  averageCost        Int     @default(0)
  allowNegativeStock Boolean @default(false)

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  createdById String?
  updatedById String?

  tenant     Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch     Branch              @relation(fields: [branchId], references: [id], onDelete: Cascade)
  ingredient InventoryIngredient @relation(fields: [ingredientId], references: [id], onDelete: Restrict)
  movements  StockMovement[]

  @@unique([tenantId, branchId, ingredientId])
  @@index([tenantId])
  @@index([tenantId, branchId])
  @@index([ingredientId])
  @@map("inventory_balances")
}

/// Kardex-style inventory movement. Every stock-changing workflow writes one.
model StockMovement {
  id              String            @id @default(cuid())
  tenantId        String
  branchId        String
  inventoryBalanceId String
  ingredientId    String
  purchaseId      String?
  purchaseItemId  String?
  type            StockMovementType

  quantity    Int
  unitCost    Int?
  totalCost   Int?
  stockBefore Int
  stockAfter  Int
  reason      String?

  createdById String
  createdAt   DateTime @default(now())

  tenant        Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch        Branch       @relation(fields: [branchId], references: [id], onDelete: Cascade)
  inventoryBalance InventoryBalance @relation(fields: [inventoryBalanceId], references: [id], onDelete: Restrict)
  ingredient    InventoryIngredient @relation(fields: [ingredientId], references: [id], onDelete: Restrict)
  purchase      Purchase?     @relation(fields: [purchaseId], references: [id], onDelete: SetNull)
  purchaseItem  PurchaseItem? @relation(fields: [purchaseItemId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([tenantId, branchId])
  @@index([inventoryBalanceId])
  @@index([ingredientId])
  @@index([purchaseId])
  @@index([tenantId, type, createdAt])
  @@map("stock_movements")
}
