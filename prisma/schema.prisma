  creditNote CreditNote @relation(fields: [creditNoteId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([creditNoteId])
  @@index([tenantId, createdAt])
  @@map("credit_note_events")
}

model DebitNote {
  id                String  @id @default(cuid())
