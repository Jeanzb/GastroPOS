# Normalize line endings: LF in the repository for all text files.
* text=auto eol=lf

# Windows-specific scripts keep CRLF on checkout.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Treat these as binary (never normalize/diff).
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
bun.lockb binary
