# Copy this file to .env and adjust values for your local environment.
# Never commit the real .env file.

# ---- PostgreSQL (used by Docker Compose) ----
POSTGRES_USER=gastroai
POSTGRES_PASSWORD=gastroai
POSTGRES_DB=gastroai
POSTGRES_PORT=5432

# ---- Prisma / API database connection ----
DATABASE_URL=postgresql://gastroai:gastroai@localhost:5432/gastroai?schema=public

# ---- Redis ----
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# ---- API ----
NODE_ENV=development
API_PORT=3000
API_GLOBAL_PREFIX=api/v1

# ---- Auth (JWT + refresh tokens) ----
JWT_ACCESS_SECRET=change-me-access-secret
JWT_ACCESS_TTL=900
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_REFRESH_TTL=1209600

# ---- CORS (comma-separated allowed origins) ----
CORS_ORIGINS=http://localhost:5173

# ---- Development seed ----
SEED_TENANT_NAME=GastroAI Demo
SEED_TENANT_SLUG=gastroai-demo
SEED_BRANCH_NAME=Sede Principal
SEED_BRANCH_CODE=MAIN
SEED_OWNER_EMAIL=owner@gastroai.local
SEED_OWNER_PASSWORD=ChangeMe123!
