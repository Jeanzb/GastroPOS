# Copy this file to .env and adjust values for your local environment.
# Never commit the real .env file.

# ---- PostgreSQL (used by Docker Compose) ----
POSTGRES_USER=gastroai
POSTGRES_PASSWORD=gastroai
POSTGRES_DB=gastroai
POSTGRES_PORT=5432

# ---- Prisma / API database connection ----
DATABASE_URL=postgresql://gastroai:gastroai@localhost:5432/gastroai?schema=public

# ---- Redis ----
REDIS_PORT=6379
REDIS_URL=redis://127.0.0.1:6379

# ---- API ----
NODE_ENV=development
API_PORT=3000
API_GLOBAL_PREFIX=api/v1

# ---- Auth (JWT + refresh tokens) ----
JWT_ACCESS_SECRET=change-me-access-secret
JWT_ACCESS_TTL=900
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_REFRESH_TTL=1209600
JWT_ISSUER=gastroai-api
JWT_AUDIENCE=gastroai-app

# Cryptographically isolated JWT signing secrets.
# Tenant/POS tokens and Platform tokens must never share secrets in production.
TENANT_JWT_ACCESS_SECRET=change-me-tenant-access-secret
TENANT_JWT_ISSUER=gastroai-tenant-api
PLATFORM_JWT_ACCESS_SECRET=change-me-platform-access-secret
PLATFORM_JWT_ISSUER=gastroai-platform-api

# ---- CORS (comma-separated allowed origins) ----
CORS_ORIGINS=http://localhost:5173

# ---- Factus / DIAN electronic invoicing ----
# Leave empty in local development until sandbox credentials are available.
FACTUS_ENV=sandbox
FACTUS_BASE_URL=https://api-sandbox.factus.com.co
FACTUS_CLIENT_ID=
FACTUS_CLIENT_SECRET=
FACTUS_USERNAME=
FACTUS_PASSWORD=
FACTUS_CREDENTIALS_ENCRYPTION_KEY=
FACTUS_TIMEOUT_MS=15000
FISCAL_QUEUE_ENABLED=true

# ---- Development seed ----
SEED_TENANT_NAME=GastroAI Demo
SEED_TENANT_SLUG=gastroai-demo
SEED_BRANCH_NAME=Sede Principal
SEED_BRANCH_CODE=MAIN
SEED_OWNER_EMAIL=owner@gastroai.local
SEED_OWNER_PASSWORD=ChangeMe123!
SEED_PLATFORM_OWNER_EMAIL=platform@gastroai.local
SEED_PLATFORM_OWNER_PASSWORD=ChangeMePlatform123!
