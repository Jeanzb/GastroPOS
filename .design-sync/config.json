  },
  "srcDir": "src/renderer/src/components/ui",
  "tsconfig": "tsconfig.json",
  "cssEntry": "ds-compiled.css",
  "extraFonts": [
    "node_modules/@fontsource-variable/bricolage-grotesque/index.css",
    "node_modules/@fontsource-variable/hanken-grotesk/index.css",
    "node_modules/@fontsource-variable/spline-sans-mono/index.css"
